# Offline mode is the default and needs no credentials.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_CONNECT_TIMEOUT_SECONDS=3
BEDROCK_READ_TIMEOUT_SECONDS=8

# Optional Bedrock Guardrail. Set both or neither.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Production should source this from Secrets Manager, never commit it.
FIDUCIA_AUDIT_HMAC_KEY=
FIDUCIA_AUDIT_HMAC_KEY_ID=
